<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native startup stays on the FinFlow brand appearance. Flutter applies
         the persisted in-app Light/Dark preference after the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#0D8F5A</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F3FBF6</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
